------------------------------------------------
--// VARIABLES
------------------------------------------------
local flySpeed = 50
local flying = false
local bodyVelocity, bodyGyro

local walkSpeedEnabled = false
local defaultWalkSpeed = 16
local customWalkSpeed = 50

local noclip = false
local noclipConnection

------------------------------------------------
--// BUTTON MAKER
------------------------------------------------
local function createButton(text, posY, color)
	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(0.8,0,0,30)
	btn.Position = UDim2.new(0.1,0,posY,0)
	btn.Text = text
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 14
	btn.TextColor3 = Color3.new(1,1,1)
	btn.BackgroundColor3 = color
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0.2,0)
	return btn
end

------------------------------------------------
--// FLY
------------------------------------------------
local flyButton = createButton("Fly : OFF [F]", 0.15, Color3.fromRGB(0,122,255))

local function toggleFly()
	flying = not flying
	flyButton.Text = flying and "Fly : ON [F]" or "Fly : OFF [F]"

	if flying then
		humanoid.PlatformStand = true

		bodyVelocity = Instance.new("BodyVelocity", rootPart)
		bodyVelocity.MaxForce = Vector3.new(math.huge,math.huge,math.huge)

		bodyGyro = Instance.new("BodyGyro", rootPart)
		bodyGyro.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)

		RunService.RenderStepped:Connect(function()
			if not flying then return end
			local cam = workspace.CurrentCamera
			local dir = Vector3.zero

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end

			if dir.Magnitude > 0 then
				bodyVelocity.Velocity = dir.Unit * flySpeed
			else
				bodyVelocity.Velocity = Vector3.zero
			end

			bodyGyro.CFrame = cam.CFrame
		end)
	else
		humanoid.PlatformStand = false
		if bodyVelocity then bodyVelocity:Destroy() end
		if bodyGyro then bodyGyro:Destroy() end
	end
end

flyButton.MouseButton1Click:Connect(toggleFly)

------------------------------------------------
--// WALK SPEED
------------------------------------------------
local walkButton = createButton("WalkSpeed : OFF [X]", 0.28, Color3.fromRGB(0,200,80))

local function toggleWalkSpeed()
	walkSpeedEnabled = not walkSpeedEnabled
	walkButton.Text = walkSpeedEnabled and "WalkSpeed : ON [X]" or "WalkSpeed : OFF [X]"
	humanoid.WalkSpeed = walkSpeedEnabled and customWalkSpeed or defaultWalkSpeed
end

walkButton.MouseButton1Click:Connect(toggleWalkSpeed)

------------------------------------------------
--// NOCLIP
------------------------------------------------
local noclipButton = createButton("NoClip : OFF", 0.41, Color3.fromRGB(255,120,0))

local function toggleNoClip()
	noclip = not noclip
	noclipButton.Text = noclip and "NoClip : ON" or "NoClip : OFF"

	if noclip then
		noclipConnection = RunService.Stepped:Connect(function()
			for _,p in pairs(character:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false end
			end
		end)
	else
		if noclipConnection then noclipConnection:Disconnect() end
	end
end

noclipButton.MouseButton1Click:Connect(toggleNoClip)

------------------------------------------------
--// TELEPORT
------------------------------------------------
local tpLabel = Instance.new("TextLabel", frame)
tpLabel.Text = "Teleport To Player"
tpLabel.Position = UDim2.new(0.1,0,0.55,0)
tpLabel.Size = UDim2.new(0.8,0,0,20)
tpLabel.BackgroundTransparency = 1
tpLabel.TextColor3 = Color3.fromRGB(160,160,160)

local dropdown = Instance.new("TextButton", frame)
dropdown.Text = "Select Player"
dropdown.Position = UDim2.new(0.1,0,0.62,0)
dropdown.Size = UDim2.new(0.55,0,0,25)
dropdown.BackgroundColor3 = Color3.fromRGB(220,220,220)

local tpBtn = Instance.new("TextButton", frame)
tpBtn.Text = "Teleport"
tpBtn.Position = UDim2.new(0.7,0,0.62,0)
tpBtn.Size = UDim2.new(0.2,0,0,25)
tpBtn.BackgroundColor3 = Color3.fromRGB(0,122,255)
tpBtn.TextColor3 = Color3.new(1,1,1)

local selectedPlayer

dropdown.MouseButton1Click:Connect(function()
	for _,plr in pairs(Players:GetPlayers()) do
		if plr ~= player then
			selectedPlayer = plr
			dropdown.Text = plr.Name
			break
		end
	end
end)

tpBtn.MouseButton1Click:Connect(function()
	if not selectedPlayer then return end
	if not selectedPlayer.Character then return end

	local targetRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
	if targetRoot and rootPart then
		rootPart.CFrame = targetRoot.CFrame * CFrame.new(0,0,-3)
	end
end)

------------------------------------------------
--// HOTKEY
------------------------------------------------
UserInputService.InputBegan:Connect(function(i,gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.F then toggleFly() end
	if i.KeyCode == Enum.KeyCode.X then toggleWalkSpeed() end
end)
